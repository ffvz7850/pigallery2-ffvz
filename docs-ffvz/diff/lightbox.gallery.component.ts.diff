+  /** 当前目录的完整列表（网格是渐进渲染的，不能拿 gridPhotoQL 当数据源） */
+  get FlowMediaList(): GridMedia[] {
+    if (!this.mediaGroups) {
+      return null;
+    }
+    if (this.flowMediaCache?.source !== this.mediaGroups) {
+      const list: GridMedia[] = [];
+      for (const group of this.mediaGroups) {
+        for (const media of group.media) {
+          list.push(new GridMedia(media, 100, 100, 0));
+        }
+      }
+      this.flowMediaCache = {source: this.mediaGroups, list};
+    }
+    return this.flowMediaCache.list;
+  }
+
+  public onFlowClosed(last: GridMedia): void {
+    this.closeFlow(true, last);
+  }
+
+  private resolveFlowEnabled(): boolean {
+    const raw = this.route.snapshot?.queryParams?.['flow'];
+    if (raw === 'true' || raw === '1') {
+      return true;
+    }
+    if (raw === 'false' || raw === '0') {
+      return false;
+    }
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const lightboxConfig = (Config as any)?.Gallery?.Lightbox;
+    return lightboxConfig?.continuousFlowView === true;
+  }
+
+  private openFlow(media: MediaDTO): boolean {
+    const list = this.FlowMediaList;
+    if (!list || list.length === 0 || !this.flow) {
+      return false;
+    }
+    let index = list.findIndex((g: GridMedia): boolean => g.media === media);
+    if (index === -1) {
+      const id = this.queryService.getMediaStringId(media);
+      index = list.findIndex((g: GridMedia): boolean =>
+        this.queryService.getMediaStringId(g.media) === id
+      );
+    }
+    if (index === -1) {
+      return false;
+    }
+    this.status = LightboxStates.Open;
+    this.overlayService.showOverlay('lightbox');
+    this.blackCanvasOpacity = 1;
+    this.activePhoto = null;
+    this.activePhotoId = index;
+    this.flow.open(list, index);
+    this.piTitleService.setMediaTitle(list[index]);
+    return true;
+  }
+
+  private tryOpenFlow(photoStringId: string): boolean {
+    if (!photoStringId) {
+      return false;
+    }
+    const list = this.FlowMediaList;
